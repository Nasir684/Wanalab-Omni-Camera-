<!-- WanaLab God Eye v2.2 - backup_rules.xml - full-backup-content -->
<!-- Author: Nasir Khan - Dera Ismail Khan, Khyber Pakhtunkhwa - 2026-11-23 -->
<!-- PRO Rs. 2,500 / Year -->
<full-backup-content>
    <!-- FIXED: Old file excluded root + database + sharedpref + external = excluded EVERYTHING, backup did nothing -->
    <!-- Only exclude sensitive / cache data, keep cameras + settings backed up -->
    <exclude domain="sharedpref" path="godeye_secure_prefs.xml" />
    <exclude domain="sharedpref" path="godeye_tokens.xml" />
    <exclude domain="database" path="godeye_cache.db" />
    <exclude domain="file" path="cache/" />
    <exclude domain="file" path="thumbnails/" />
    <exclude domain="external" path="DCIM/GodEye/temp/" />
</full-backup-content>
